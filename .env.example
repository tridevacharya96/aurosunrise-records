APP_NAME="Aurosunrise Records"
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# ─────────────────────────────────────────────────────────
# PORT CONFIG
# Auromax Digital is on :8000 — Aurosunrise runs on :8001
# Start with: php artisan serve --port=8001
# Vite HMR runs on: http://localhost:5174
# ─────────────────────────────────────────────────────────
APP_URL=http://localhost:8001
ASSET_URL=http://localhost:8001

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aurosunrise_records
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

VITE_APP_URL="${APP_URL}"
